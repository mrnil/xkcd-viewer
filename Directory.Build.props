<Project>

  <!-- Shared by every project in the repo. Project-specific settings stay in each .csproj. -->
  <PropertyGroup>
    <!-- PluginApi.dll 6.4.1+ is built against .NET 10; a net8.0 target fails to resolve it (CS1705). -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <PluginApiDir Condition="$(OS) == 'Windows_NT'">C:\Program Files\Logi\LogiPluginService\</PluginApiDir>
    <PluginApiDir Condition="$(OS) != 'Windows_NT'">/Applications/Utilities/LogiPluginService.app/Contents/MonoBundle/</PluginApiDir>
  </PropertyGroup>

  <!-- A file reference doesn't flow through a ProjectReference at compile time, so every project that touches
       PluginApi types (the tests use DeviceType) needs its own. Logi Plugin Service supplies PluginApi and its
       dependencies at runtime, so the plugin must not copy them into its output (and the .lplug4); the tests run
       outside the service and do need the copy. -->
  <ItemGroup>
    <Reference Include="PluginApi">
      <HintPath>$(PluginApiDir)PluginApi.dll</HintPath>
      <Private Condition="'$(MSBuildProjectName)' == 'xkcdviewerPlugin'">false</Private>
    </Reference>
  </ItemGroup>

</Project>
