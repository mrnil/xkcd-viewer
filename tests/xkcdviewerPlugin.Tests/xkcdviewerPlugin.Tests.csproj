<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, LangVersion, code style enforcement and the PluginApi reference come from the repo-root
       Directory.Build.props. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Loupedeck.xkcdviewerPlugin.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <!-- Real responses captured from the live API; see Fixtures/README.md. -->
  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The plugin's manifest, so PackageVersionTests can check the DLL's version against it. -->
  <ItemGroup>
    <None Include="..\..\src\xkcdviewerPlugin\package\metadata\LoupedeckPackage.yaml" Link="Package\LoupedeckPackage.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\xkcdviewerPlugin\xkcdviewerPlugin.csproj" />
  </ItemGroup>

</Project>
